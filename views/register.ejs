<!DOCTYPE html>

<html>
<head>
    <link href='https://fonts.googleapis.com/css?family=Open+Sans:700,600' rel='stylesheet' type='text/css'>
    <link href="./styles.css" rel="stylesheet" type="text/css">
    <meta charset="utf-8">
    <title>BlastMaze</title>
</head>

<body>
<form method="post" action="/register">
    <div class="box">

        <h1>Register</h1>
        <% if(message.length > 0) { %>
            <div class="alert_message"><%= message %></div>
        <% } %>
        Username <input type="username" name="username" value=""  class="username" />

        Password <input type="password" name="password" value="" class="password" />

         <button type="submit" id="btn2">Sign Up</button>

    </div>

</form>

<p>Already have an account? <u style="color:#f1c40f;"> <a href="./login"> Click Here! </a></u></p>

</body>
</html>